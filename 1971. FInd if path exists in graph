class Solution {
    void dfs(int source,int destination,vector <int> adj[],vector <int> &vis,bool &c){
        vis[source]=1;
        if (source==destination){
            c=true;
            return;
        }
        for (auto it:adj[source]){
            if (vis[it]==-1){
                dfs(it,destination,adj,vis,c);
            }
        }
    }
public:
    bool validPath(int n, vector<vector<int>>& edges, int source, int destination) {
        vector <int> adj[n];
        for (int i=0;i<edges.size();i++){
            adj[edges[i][0]].push_back(edges[i][1]);
            adj[edges[i][1]].push_back(edges[i][0]);
        }
        vector <int> vis(n,-1);
        bool c=false;
        dfs(source,destination,adj,vis,c);
        return c;
    }
};
