class Solution {
    int count(vector <int> &coins,vector <vector <int>> &dp,int amount,int ind){
        if (ind==0){
            if ((amount%coins[ind])==0){
                return 1;
            }
            return 0;
        }
        if (dp[ind][amount]!=-1){
            return dp[ind][amount];
        }
        int take=0;
        if (coins[ind]<=amount){
            take=count(coins,dp,amount-coins[ind],ind);
        }
        int ntake=count(coins,dp,amount,ind-1);
        return dp[ind][amount]=take+ntake;
    }
public:
    int change(int amount, vector<int>& coins) {
        vector <vector <int>> dp(coins.size(),vector <int> (amount+1,-1));
        int ans=count(coins,dp,amount,coins.size()-1);
        if (ans!=-1){
            return ans;
        }
        return 0;
    }
};
