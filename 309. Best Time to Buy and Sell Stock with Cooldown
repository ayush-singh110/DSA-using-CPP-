class Solution {
    int cool(vector <int> &prices,vector <vector <int>> &dp,int buy,int ind){
        if (ind>=prices.size()){
            return 0;
        }
        if (dp[ind][buy]!=-1){
            return dp[ind][buy];
        }
        int profit;
        if (buy){
            profit=max(-prices[ind]+cool(prices,dp,0,ind+1),0+cool(prices,dp,1,ind+1));
        }
        else{
            profit=max(prices[ind]+cool(prices,dp,1,ind+2),0+cool(prices,dp,0,ind+1));
        }
        return dp[ind][buy]=profit;
    }
public:
    int maxProfit(vector<int>& prices) {
        vector <vector <int>> dp(prices.size(),vector <int> (2,-1));
        return cool(prices,dp,1,0);
    }
};
